{
  "name": "pi-terminal-kit",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test test/*.test.mjs",
    "lint": "pnpm format:check && pnpm typecheck",
    "pack:check": "node test/pack.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
